{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/admin/*.js": {
      "maxDuration": 15
    },
    "api/auth/*.js": {
      "maxDuration": 15
    },
    "api/attendance.js": {
      "maxDuration": 30
    },
    "api/face-match.js": {
      "maxDuration": 30
    },
    "api/index.js": {
      "maxDuration": 10
    },
    "api/send-wa.js": {
      "maxDuration": 15
    },
    "api/settings.js": {
      "maxDuration": 15
    },
    "api/students.js": {
      "maxDuration": 30
    },
    "api/teachers.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "^/api/health$",
      "dest": "/api/index?health=1"
    },
    {
      "src": "^/api/auth/logout$",
      "dest": "/api/auth/login?action=logout"
    },
    {
      "src": "^/api/admin/dashboard-stats$",
      "dest": "/api/admin/audit?action=stats"
    },
    {
      "src": "^/api/admin/profile$",
      "dest": "/api/admin/settings?action=profile"
    },
    {
      "src": "^/api/admin/test-tools$",
      "dest": "/api/admin/settings?action=test-tools"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
