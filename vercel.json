{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/admin/*.js": {
      "maxDuration": 15
    },
    "api/auth/*.js": {
      "maxDuration": 15
    },
    "api/attendance.js": {
      "maxDuration": 30
    },
    "api/face-match.js": {
      "maxDuration": 30
    },
    "api/send-wa.js": {
      "maxDuration": 15
    },
    "api/settings.js": {
      "maxDuration": 15
    },
    "api/students.js": {
      "maxDuration": 30
    },
    "api/teachers.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "^/api$",
      "dest": "/api/settings"
    },
    {
      "src": "^/api/ready$",
      "dest": "/api/settings?action=ready"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/settings?action=health"
    },
    {
      "src": "^/api/auth/logout$",
      "dest": "/api/auth/login?action=logout"
    },
    {
      "src": "^/api/admin/dashboard-stats$",
      "dest": "/api/admin/audit?action=stats"
    },
    {
      "src": "^/api/admin/profile$",
      "dest": "/api/admin/settings?action=profile"
    },
    {
      "src": "^/api/admin/test-tools$",
      "dest": "/api/admin/settings?action=test-tools"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://api.github.com https://cdn.jsdelivr.net https://unpkg.com https://huggingface.co https://*.huggingface.co https://cas-bridge.xethub.hf.co; worker-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
